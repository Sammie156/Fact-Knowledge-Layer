# ==============================================================================
# Fact Knowledge Layer - Environment Configuration
# ==============================================================================

# Required: Google Gemini API Key for fact extraction and reasoning
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Database URL
# When running with Docker Compose, this is automatically configured to point to the 'db' container.
# If running locally with Python outside Docker, use localhost:
DATABASE_URL=postgresql+psycopg://postgres:factstuff@localhost:5432/factdb

# Optional: Groq API Key for lightning-fast Llama-3.3 inference and automatic rate-limit failover
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=gemini
